# QuantumShield — Environment Variables
# Copy this file to `.env` and fill in real values before deploying.
# The `.env` file is gitignored and must NEVER be committed.

# ── JWT / Auth ─────────────────────────────────────────────────────────────
# Replace with a long, random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super_secret_quantum_key_phase2_replace_me_in_prod

# ── Database ───────────────────────────────────────────────────────────────
# Default: SQLite (no extra setup needed for local dev)
# Production (PostgreSQL): postgresql://user:password@localhost:5432/quantumshield
DATABASE_URL=sqlite:///./quantumshield.db

# ── Token Expiry ───────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
